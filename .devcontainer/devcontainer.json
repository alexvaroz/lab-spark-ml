{
  "name": "lab-spark-ml",
  "image": "mcr.microsoft.com/devcontainers/base:ubuntu",
  "features": {
    "ghcr.io/devcontainers/features/docker-in-docker:2": {}
  },
  "forwardPorts": [9870, 8080, 8081, 8082, 4040],
  "portsAttributes": {
    "9870": { "label": "HDFS Namenode" },
    "8080": { "label": "Spark Master" },
    "8081": { "label": "Spark Worker 1" },
    "8082": { "label": "Spark Worker 2" },
    "4040": { "label": "Spark Application UI" }
  }
}
